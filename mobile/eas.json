{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-NGROK-OR-STAGING.ngrok-free.app/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://REPLACE-WEB-URL"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://<domain-production>/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://<domain-production>"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
