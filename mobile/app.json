{
  "expo": {
    "name": "PalmSight",
    "slug": "palmsight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "palmsight",
      "com.googleusercontent.apps.1001438141254-gke8cgoedgalg77eqfv0fkn39c5r420s",
      "com.googleusercontent.apps.1001438141254-j0n1titmkvoqg0d7fbp7qcji3hdj8hv6"
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0716",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.palmsight.app"
    },
    "android": {
      "package": "com.palmsight.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0716",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0716",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PalmSight cần camera để chụp ảnh lòng bàn tay của bạn."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
