# Sao chép thành .env rồi đổi cho đúng môi trường bạn đang chạy.
# App native trên máy thật không truy cập được localhost của máy tính:
#   - Backend dev trên LAN:   http://<IP-của-máy-bạn>:4000/api/v1
#   - Qua ngrok:              https://<ten-subdomain>.ngrok-free.app/api/v1
# Đổi giá trị này chỉ cần restart Metro (`npx expo start -c`), không cần rebuild.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api/v1
# Web PalmSight (PWA) — trang hướng dẫn xoá dữ liệu chỉ tồn tại trên web
EXPO_PUBLIC_WEB_URL=http://192.168.1.100:5173
