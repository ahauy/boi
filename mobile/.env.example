# Sao chép thành .env rồi đổi cho đúng môi trường bạn đang chạy.
# App native trên máy thật không truy cập được localhost của máy tính:
#   - Backend dev trên LAN:   http://<IP-của-máy-bạn>:4000/api/v1
#   - Qua ngrok:              https://<ten-subdomain>.ngrok-free.app/api/v1
# Đổi giá trị này chỉ cần restart Metro (`npx expo start -c`), không cần rebuild.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api/v1
# Web PalmSight (PWA) — các link chỉ tồn tại trên web: /data-deletion, link xác minh & reset mật khẩu
EXPO_PUBLIC_WEB_URL=http://192.168.1.100:5173

# ---------- Đăng nhập Google / Facebook (tuỳ chọn) ----------
# Bỏ trống thì nút tương ứng bị ẩn; app vẫn đăng nhập được bằng email + mật khẩu.
# Google: Google Cloud Console > Credentials > OAuth client ID, tạo riêng cho Android, iOS và Web.
#   - Android client phải trùng package name trong app.json > expo.android.package (hiện chưa khai báo, cần tự thêm)
#   - iOS client phải trùng bundle identifier của app
# Facebook: developers.facebook.com > App > Settings > Basic > App ID.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Sau khi có ID thật, khai báo redirect scheme vào app.json > expo.scheme (dạng mảng):
#   "scheme": [
#     "palmsight",
#     "com.googleusercontent.apps.<ANDROID_CLIENT_ID_BỎ_HẬU_TỐ_.apps.googleusercontent.com>",
#     "com.googleusercontent.apps.<IOS_CLIENT_ID_BỎ_HẬU_TỐ_.apps.googleusercontent.com>",
#     "fb<FACEBOOK-APP-ID>"
#   ]
# (app dùng redirectUri = com.googleusercontent.apps.<id>:/oauthredirect, xem login.tsx)
# và thêm client ID native vào GOOGLE_MOBILE_CLIENT_IDS của backend.
# OAuth native không chạy trong Expo Go — Expo Go đi qua backend OAuth broker:
# backend cần GOOGLE_OAUTH_REDIRECT_URI trỏ tới callback HTTPS công khai (ngrok khi dev).
# Dev build dùng OAuth native như bình thường.
