EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# AppLovin MAX (Playbook §1.2 — put real SDK key in .env.local, never commit to git)
APPLOVIN_SDK_KEY=
EXPO_PUBLIC_MAX_ANDROID_BANNER_ID=
EXPO_PUBLIC_MAX_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_MAX_ANDROID_REWARDED_ID=
EXPO_PUBLIC_MAX_ANDROID_NATIVE_ID=
EXPO_PUBLIC_MAX_ANDROID_MREC_ID=
EXPO_PUBLIC_MAX_ANDROID_APP_OPEN_ID=
EXPO_PUBLIC_MAX_TEST_DEVICE_IDS=

# AdMob App ID (public; goes into the Android manifest via config plugin, not env)
# ca-app-pub-7441372574696038~4265117368

# Adjust
EXPO_PUBLIC_ADJUST_APP_TOKEN=
EXPO_PUBLIC_ADJUST_PURCHASE_EVENT_TOKEN=
EXPO_PUBLIC_ADJUST_ENVIRONMENT=sandbox

# Google Play subscriptions
EXPO_PUBLIC_SUB_WEEKLY_ID=weeklyid
EXPO_PUBLIC_SUB_YEARLY_ID=yearlyid
EXPO_PUBLIC_SUB_MONTHLY_ID=

# Legacy / Dev flags
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADS_MOCK=false
