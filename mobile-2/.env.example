EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Quảng cáo thưởng (rewarded ads). Mặc định tắt: toàn bộ lời đề nghị "xem quảng cáo nhận credit"
# ẩn khỏi app, và code không import thử native module ads nào nên Expo Go + bản web chạy bình thường.
# Chỉ bật sau khi đã có AdMob app ID, cài SDK và chuyển sang bản dev build (không dùng Expo Go).
EXPO_PUBLIC_ADS_ENABLED=false
# AdMob > Apps > <app> > Reward video unit (dùng unit test của Google khi còn dev:
# reward android/ios xem trong docs AdMob)
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
