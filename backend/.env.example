# PalmSight API (backend/) — biến môi trường
# Copy thành backend/.env và điền giá trị. KHÔNG commit file .env (repo công khai).
# File này chứa secret của server; frontend có file riêng ở frontend/.env.example.
# Production: đặt các biến này trong phần Environment của Render, không dùng file.

# ---------- Chung ----------
NODE_ENV=development
API_PORT=4000
# URL công khai của web: dùng để tạo link trong email và kiểm tra header Origin.
# Dev qua ngrok: https://<static-domain>.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:5173

# ---------- Database ----------
# Local: MongoDB phải chạy dạng replica set 1 node (mongod --replSet rs0) thì mới dùng được transaction.
# directConnection=true: kết nối thẳng tới node, đúng cả khi Docker ánh xạ sang cổng khác (ví dụ 27019->27017).
# Không thêm replicaSet=rs0 cùng directConnection: một số công cụ (Compass…) báo lỗi khi có cả hai.
# Prod: chuỗi mongodb+srv:// của MongoDB Atlas (user palmsight-app)
MONGODB_URI=mongodb://localhost:27019/palmsight?directConnection=true

# ---------- Auth ----------
# Chuỗi ngẫu nhiên >= 32 byte: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Đăng ký email/mật khẩu (docs/adr/0008-email-password-auth.md)
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Khoá HMAC cho deleted_identities (docs/adr/0009-manual-account-deletion.md)
# Chuỗi ngẫu nhiên >= 32 byte. KHÔNG BAO GIỜ ĐỔI sau khi đã có dữ liệu: đổi là mất hiệu lực toàn bộ danh sách chặn
IDENTITY_HASH_SECRET=change-me
# Email nhận yêu cầu xoá tài khoản (hiện trên trang /data-deletion)
SUPPORT_EMAIL=palmsight.app@gmail.com
# Số tài khoản khách ẩn danh tối đa được tạo từ một IP trong 24 giờ (chống cài lại app farm credit).
# Đừng đặt quá thấp: mạng di động dùng CGNAT nên nhiều người thật có thể chung một IP.
ANONYMOUS_SIGNUP_DAILY_CAP=20
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Cùng giá trị với VITE_GOOGLE_CLIENT_ID của frontend
GOOGLE_CLIENT_ID=
# Client ID Android/iOS dùng cho app mobile (Expo), phân tách bằng dấu phẩy nếu có nhiều.
# Bỏ trống nếu chưa bật đăng nhập Google trên mobile.
GOOGLE_MOBILE_CLIENT_IDS=
# OAuth trung gian cho Expo Go: URL callback HTTPS công khai (ngrok khi dev), phải khai báo
# đúng URL này trong Authorized redirect URIs của OAuth client Web trên Google Console
GOOGLE_OAUTH_REDIRECT_URI=
# Client secret của cùng OAuth client, dùng để đổi authorization code lấy ID token. Chỉ đặt ở backend
GOOGLE_CLIENT_SECRET=
# developers.facebook.com > App > Settings > Basic
# FACEBOOK_APP_ID cùng giá trị với VITE_FACEBOOK_APP_ID của frontend
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Gửi email (SMTP) ----------
# Dev: Mailpit trong docker-compose (không gửi ra ngoài, xem mail ở http://localhost:8025)
# Prod: Gmail SMTP — SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#       SMTP_USER=<gmail của dự án>, SMTP_PASS=<App Password 16 ký tự, KHÔNG phải mật khẩu Gmail>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PalmSight <no-reply@palmsight.local>"

# ---------- AI ----------
# gemini | groq
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=qwen/qwen3.8-27b
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
AI_TIMEOUT_MS=25000
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_THINKING_BUDGET=0

# ---------- Nghiệp vụ Economy / Currency (Playbook §1.1 & §1.2) ----------
CURRENCY=GEM
PRICE_PER_ACTION=5
MAX_ACTIONS_PER_TAP=5
STARTER_GRANT=5
STARTER_NETWORK_DAILY_CAP=5
REWARD_TZ=Asia/Ho_Chi_Minh
STREAK_LENGTH=365
RESTORE_COST_PER_DAY=10
RESTORE_MAX_MISSED=3
FREE_SPINS=1
AD_SPINS=3
CURRENCY_SPIN_COST=3
CHECKIN_DOUBLE_CAP=1
BONUS_AD_AMOUNT=3
BONUS_AD_CAP=5
VIP_DAILY=50
MIN_AD_WATCH_SECONDS=15
MAX_REWARD_EVENT_KEY=

# ---------- Google Play Billing ----------
# Bắt buộc khi deploy: thiếu service account thì /billing/verify trả 503, không cấp VIP.
GOOGLE_PLAY_PACKAGE_NAME=com.palmsight.mobile2
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pub/Sub push URL: <API>/api/v1/billing/rtdn?token=<RTDN_PUSH_TOKEN>. Rỗng = đóng webhook.
RTDN_PUSH_TOKEN=

# Legacy aliases (giữ tương thích ngược)
SIGNUP_BONUS_CREDITS=5
READING_COST_CREDITS=5
REFERRAL_DAILY_CAP=5
# Số lần nhận thưởng người được mời trên mỗi mạng mỗi ngày giờ Việt Nam.
REFERRAL_NETWORK_DAILY_CAP=5
# Header có mục đầu là IP thật do hạ tầng đảm bảo (Render: x-forwarded-for). Rỗng = dùng IP socket.
# Thiếu header hoặc IP nội bộ thì giới hạn theo mạng bỏ qua, không gộp mọi người vào một IP.
CLIENT_IP_HEADER=

# ---------- Quảng cáo thưởng (rewarded ads) ----------
REWARDED_ADS_ENABLED=true

# ---------- Ảnh & Cloudinary (docs/adr/0011-cloudinary-image-storage-and-onnx-palm-lines.md) ----------
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_DIMENSION=1280
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=palmsight/readings
