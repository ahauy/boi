{
  "name": "palmsight",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "start": "pnpm --filter mobile start",
    "start:web": "pnpm --filter mobile exec expo start --web",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:mobile": "pnpm --filter mobile start",
    "typecheck:mobile": "pnpm --filter mobile typecheck",
    "test:frontend": "pnpm --filter frontend test",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "stitch:sync": "node scripts/sync-stitch-screens.mjs",
    "push": "bash scripts/modular-push.sh",
    "prepare": "pnpm --filter @palmsight/shared build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
